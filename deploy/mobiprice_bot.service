[Unit]
Description=MobiPrice Telegram Admin & CRM Bot Service
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/mobiprice
ExecStart=/var/www/mobiprice/.venv/bin/python -m bot.main
Restart=always
RestartSec=5
EnvironmentFile=/var/www/mobiprice/.env

[Install]
WantedBy=multi-user.target
