[Unit]
Description=MobiPrice Django Gunicorn Web Service
After=network.target

[Service]
Type=notify
User=www-data
Group=www-data
WorkingDirectory=/var/www/mobiprice
ExecStart=/var/www/mobiprice/.venv/bin/gunicorn -c deploy/gunicorn.conf.py config.wsgi:application
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=10
PrivateTmp=true
Restart=always
RestartSec=5
EnvironmentFile=/var/www/mobiprice/.env

[Install]
WantedBy=multi-user.target
