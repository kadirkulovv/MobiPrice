msgstr "Готов"

msgid "Topshirildi"
msgstr "Выдан"

msgid "Bekor qilindi"
msgstr "Отменен"

msgid "O'zim boraman (Servis markaziga)"
msgstr "Приеду сам (в сервисный центр)"

msgid "Kuryer orqali olib ketish"
msgstr "Забрать через курьера"

msgid "Original Zavod (Service Pack)"
msgstr "Оригинал Завод (Service Pack)"

msgid "Original Donar (Yechib olingan)"
msgstr "Оригинал Донор (Снятый)"

msgid "OLED GX / ZY (Originalga eng yaqin)"
msgstr "OLED GX / ZY (Максимально близко к оригиналу)"

